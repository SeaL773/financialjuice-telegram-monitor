TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_chat_id
TG_THREAD_ID=0
# Experimental Bot API Rich Messages. Disabled by default; this is separate from
# Telegram clients' Rich Text Editor and only affects initial simple breaking alerts.
FJ_TELEGRAM_RICH_MESSAGES_ENABLED=false

FJ_EMAIL=your_financialjuice_email
FJ_PASSWORD=your_financialjuice_password

# Optional monitor tuning
FJ_COOKIES_PATH=/app/data/cookies.json
FJ_WS_RECONNECT_BASE_DELAY=3
FJ_WS_RECONNECT_MAX_DELAY=60
FJ_WS_RECEIVE_TIMEOUT=180
FJ_POLL_FALLBACK_INTERVAL=15
FJ_FEEDTOKEN_REFRESH_HOURS=6

# Optional English-to-Chinese translation through an OpenAI-compatible API.
FJ_TRANSLATE_ENABLED=false
# Existing delivered alerts without an applied marker are retried after enabling.
FJ_TRANSLATE_API_KEY=replace_with_provider_key
FJ_TRANSLATE_API_KEY_FILE=
FJ_TRANSLATE_API_KEY_FILE_HOST=/path/to/cliproxy-api-key
FJ_TRANSLATE_BASE_URL=https://api.moonshot.cn/v1
FJ_TRANSLATE_MODEL=kimi-k2.6
FJ_TRANSLATE_TIMEOUT=60
FJ_TRANSLATE_MAX_TOKENS=256
FJ_TRANSLATE_TEMPERATURE=0.6
FJ_TRANSLATE_HEADERS_JSON={}
FJ_TRANSLATE_EXTRA_BODY_JSON={}

# Provider examples (choose one base URL/model pair):
# OpenAI:    https://api.openai.com/v1                  / gpt-4.1-mini
# DeepSeek:  https://api.deepseek.com/v1                / deepseek-chat
# OpenRouter:https://openrouter.ai/api/v1                / openai/gpt-4.1-mini
# Local:     http://host.docker.internal:8000/v1        / your-local-model
# Local compatible servers may leave FJ_TRANSLATE_API_KEY empty.
# OpenRouter metadata can be supplied with FJ_TRANSLATE_HEADERS_JSON, for example:
# {"HTTP-Referer":"https://example.com","X-OpenRouter-Title":"financialjuice-monitor"}

# Deprecated compatibility aliases. Prefer FJ_TRANSLATE_* above.
# KIMI_API_KEY=replace_with_provider_key
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=moonshot-v1-8k
